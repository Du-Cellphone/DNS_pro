{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "default",
      "displayName": "Default tests",
      "inherits": "base"
    },
    {
      "name": "strict-sockets",
      "displayName": "Socket tests required",
      "inherits": "base",
      "cacheVariables": {
        "DNS_PRO_REQUIRE_SOCKET_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "DNS_PRO_ENABLE_ADDRESS_SANITIZER": "ON"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "DNS_PRO_ENABLE_UNDEFINED_BEHAVIOR_SANITIZER": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "DNS_PRO_ENABLE_THREAD_SANITIZER": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Clang libFuzzer targets",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_CXX_COMPILER": "clang++",
        "DNS_PRO_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "strict-sockets",
      "configurePreset": "strict-sockets"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": [
        "dns_protocol_parser_fuzz",
        "dns_service_boundary_fuzz"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "strict-sockets",
      "configurePreset": "strict-sockets",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:history_size=7"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
